[project]
	description = A location-based photo sharing system
[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/Shawn W (shawnhero)
[access "refs/for/refs/*"]
	read = group user/Shawn W (shawnhero)
	push = group user/Shawn W (shawnhero)
	label-Code-Review = -2..+2 group user/Shawn W (shawnhero)
	label-Verified = -1..+1 group user/Shawn W (shawnhero)
	rebase = group user/Shawn W (shawnhero)
	removeReviewer = group user/Shawn W (shawnhero)
	submit = group user/Shawn W (shawnhero)
[access "refs/heads/*"]
	read = group user/Shawn W (shawnhero)
	create = group user/Shawn W (shawnhero)
	push = +force group user/Shawn W (shawnhero)
	pushMerge = group user/Shawn W (shawnhero)
[access "refs/tags/*"]
	push = +force group user/Shawn W (shawnhero)
	pushTag = group user/Shawn W (shawnhero)
	pushSignedTag = group user/Shawn W (shawnhero)
